{
  "name": "obraja-2.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter @obraja/database generate",
    "db:migrate": "pnpm --filter @obraja/database migrate:dev",
    "db:push": "pnpm --filter @obraja/database db:push",
    "db:seed": "pnpm --filter @obraja/database db:seed",
    "db:studio": "pnpm --filter @obraja/database studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
