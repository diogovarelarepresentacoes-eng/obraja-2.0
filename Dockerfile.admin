FROM node:20-alpine AS builder
WORKDIR /app

RUN npm install -g pnpm@9.1.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages/types/package.json ./packages/types/
COPY packages/config/package.json ./packages/config/
COPY apps/web-admin/package.json ./apps/web-admin/

RUN pnpm install --frozen-lockfile

COPY packages/config ./packages/config
COPY packages/types/src ./packages/types/src
COPY packages/types/tsconfig.json ./packages/types/
COPY apps/web-admin ./apps/web-admin

RUN pnpm --filter @obraja/types build

ARG NEXT_PUBLIC_API_URL=https://api.srv1131489.hstgr.cloud/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm --filter @obraja/web-admin build

FROM node:20-alpine
WORKDIR /app

COPY --from=builder /app/apps/web-admin/.next/standalone ./
COPY --from=builder /app/apps/web-admin/.next/static ./apps/web-admin/.next/static
RUN mkdir -p ./apps/web-admin/public

ENV NODE_ENV=production
ENV PORT=3002
ENV HOSTNAME=0.0.0.0
EXPOSE 3002

CMD ["node", "apps/web-admin/server.js"]
