# ==========================================
# OBRAJA 2.0 — Variáveis de Ambiente
# Copie para .env e preencha os valores
# NUNCA commite o .env com valores reais
# ==========================================

# Banco de Dados
DATABASE_URL="postgresql://obraja:obraja123@localhost:5432/obraja2"

# JWT
JWT_SECRET="troque-este-secret-em-producao"
JWT_REFRESH_SECRET="troque-este-refresh-secret-em-producao"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003"

# Pagamentos (Asaas)
ASAAS_API_KEY=""
ASAAS_ENVIRONMENT="sandbox"
# sandbox: https://sandbox.asaas.com/api/v3
# production: https://api.asaas.com/api/v3

# Nota Fiscal Eletrônica (Focus NFe)
FOCUS_NFE_TOKEN=""
FOCUS_NFE_ENVIRONMENT="homologacao"
# homologacao | producao

# Storage (Cloudflare R2 — compatível S3)
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
# Ex: https://<account-id>.r2.cloudflarestorage.com

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ObraJá <noreply@obraja.com.br>"

# Redis
REDIS_URL="redis://localhost:6379"

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Lookup de CNPJ (BrasilAPI — gratuito, sem chave)
BRASIL_API_URL="https://brasilapi.com.br/api"

# Google Maps (para calcular frete por distância)
GOOGLE_MAPS_API_KEY=""
